# ================================================
# Anime-Public-DB-Mapper — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# Your Supabase (or any Postgres) connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Set to "false" only if your DB doesn't use SSL (e.g. local Postgres)
DATABASE_SSL=true

# Max DB connections (keep low for serverless, higher for always-on servers)
DB_POOL_MAX=5

# Port for local/Docker/Render/Railway (Vercel ignores this)
PORT=3000
